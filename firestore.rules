rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check user authentication and ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Newsletter subscriber data is server-only.
    // The Vercel API writes via Firebase Admin SDK after validation and anti-abuse checks.
    // Admin SDK calls bypass these rules; all browser SDK access is denied to prevent
    // email-subscription enumeration and direct bypass of the protected API endpoint.
    match /newsletterSubscribers/{subscriberId} {
      allow read, write: if false;
    }

    // User Profile: Accessible exclusively by the authenticated user
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User's Golden Circle saved canvases: Owner isolated
      match /canvases/{canvasId} {
        allow read, write: if isOwner(userId);
      }

      // User's podcast bookmarks: Owner isolated
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
