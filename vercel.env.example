# ==============================================================================
# Vercel Environment Variables Template — WHY, PRACTICED
# ==============================================================================
# Configure these variables in Vercel Project Settings > Environment Variables
# ONLY when deploying this project to Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Vite Frontend - Public)
# Scope: All Environments (Production, Preview, Development)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSy_YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_DATABASE_ID="ai-studio-9a10e882-4e4e-4882-bc66-23bde83789c9"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE VARIABLES (Vercel Serverless Functions - Private Secret)
# Scope: Production, Preview (DO NOT prefix with VITE_)
# ------------------------------------------------------------------------------
# Option A: Full Service Account JSON string (recommended)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id",...}'

# Option B: Individual Service Account fields (alternative)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_ID="ai-studio-9a10e882-4e4e-4882-bc66-23bde83789c9"
