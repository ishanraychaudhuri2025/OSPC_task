# WHY, PRACTICED — Vercel environment variable checklist.
# This is documentation only. Add actual values in Vercel Project Settings > Environment Variables.
# Do not commit a populated file with real credentials.

APP_URL=

# Frontend Firebase configuration (public client config, injected at build time by Vite).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Server-only Firebase Admin SDK credentials for api/newsletter.ts.
# Preferred option: service-account JSON stored as one server-only environment variable.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Alternative to FIREBASE_SERVICE_ACCOUNT_KEY:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Target Firebase project and named Firestore database used by the Admin SDK.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
