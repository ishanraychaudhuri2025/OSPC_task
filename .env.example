# ==============================================================================
# WHY, PRACTICED — Environment Variables Guide
# ==============================================================================
# Use this template to configure environment variables in Vercel or local .env.
# NEVER commit real secret values, private keys, or service-account JSON files to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL
# Public / Hosting runtime
# ------------------------------------------------------------------------------
APP_URL="https://your-project.vercel.app"

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE FIREBASE CONFIGURATION (Vite Public - prefix VITE_)
# Location: Vercel Project Settings > Environment Variables (All Environments)
# Note: These values are bundled into client code and identify the Firebase project.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSy_YOUR_API_KEY_HERE"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_DATABASE_ID="your-named-firestore-database-id"

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE FIREBASE ADMIN CONFIGURATION (Private / Server-Only Secrets)
# Location: Vercel Project Settings > Environment Variables (Serverless Function / Production)
# Security: DO NOT prefix with VITE_. These are accessible only to serverless functions.
# ------------------------------------------------------------------------------
# Option A: Full Service Account JSON string (recommended for Vercel)
# Obtain from Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com"}'

# Option B: Individual Service Account credentials (alternative)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_ID="your-named-firestore-database-id"
FIREBASE_API_KEY="AIzaSy_YOUR_API_KEY_HERE"
