# WHY, PRACTICED — environment variable names only.
# Set actual values in the AI Studio environment or Vercel Project Settings.
# Never commit a populated .env file.

APP_URL=

# Public Firebase Web SDK configuration (required for a GitHub/Vercel build).
# These values identify the Firebase web app; authorization is enforced by Firebase Auth and Firestore Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Server-side reCAPTCHA Enterprise assessment for /api/newsletter.
# Create a dedicated service account with the reCAPTCHA Enterprise Agent role.
# Store the service-account JSON as a server-only environment variable, never in Git.
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_ENTERPRISE_SITE_KEY=
RECAPTCHA_ENTERPRISE_SERVICE_ACCOUNT_KEY=
RECAPTCHA_ENTERPRISE_MIN_SCORE=0.5
# Set true to require verification even when configuration is incomplete.
# With all server settings configured, checks are enabled automatically unless set to false.
RECAPTCHA_ENTERPRISE_REQUIRED=

# Public reCAPTCHA Enterprise site key for the newsletter form.
# This key is intentionally visible in browser requests; restrict it to your production domains.
VITE_FIREBASE_APP_CHECK_RECAPTCHA_ENTERPRISE_KEY=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Private server-only Firebase Admin configuration (newsletter API on Vercel).
# Supply either FIREBASE_SERVICE_ACCOUNT_KEY, or FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY.
# Also set the target project and the exact named Firestore database.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_ID=
